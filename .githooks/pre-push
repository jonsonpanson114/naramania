#!/bin/sh
# スクレイパー・フィルタを変更したまま検証せずに push するのを防ぐ。
#
# 【背景】
# 20市町村の内部プレフィルタを一括撤去した際、本線の採用件数しか確認せずに push し、
# 山添村の広報記事が「落札なのに開札日なし」で混入していることに気づけなかった。
# Daily Scrape が Validate Quality で落ち続け、commit/push まで到達しないため
# データが2日間更新されない状態になった。
#
# 【重要】
# validate:quality などはディスク上の scraper_result.json を読むだけなので、
# .ts を変えてデータを再生成せずに実行しても必ず通ってしまう。データを伴わない
# 検証には意味がないため、ここでは
#   1. データ非依存の検証(型・lint・フィルタの単体テスト)は必ず実行
#   2. データを再生成した push なら、CIと同じ検証も実行
#   3. スクレイパーを変えたのにデータ未再生成なら、verify:scrapers を促して止める
# の3段構えにしている。
#
# 一時的に迂回したい場合: git push --no-verify

set -e

RED=''
YELLOW=''
GREEN=''
BOLD=''
RESET=''
if [ -t 2 ]; then
  RED='\033[31m'; YELLOW='\033[33m'; GREEN='\033[32m'; BOLD='\033[1m'; RESET='\033[0m'
fi

say() { printf "%b[pre-push]%b %b\n" "$BOLD" "$RESET" "$1" >&2; }

# push しようとしている範囲の変更ファイルを集める
ZERO=0000000000000000000000000000000000000000
CHANGED=""
while read -r _local_ref local_oid _remote_ref remote_oid; do
  [ "$local_oid" = "$ZERO" ] && continue          # ブランチ削除
  if [ "$remote_oid" = "$ZERO" ]; then            # 新規ブランチ
    base=$(git merge-base "$local_oid" origin/main 2>/dev/null || echo "")
  else
    base="$remote_oid"
  fi
  if [ -n "$base" ]; then
    CHANGED="$CHANGED$(git diff --name-only "$base" "$local_oid" 2>/dev/null)
"
  fi
done

# stdin が空(手動実行など)のときは upstream との差分にフォールバック
if [ -z "$(printf '%s' "$CHANGED" | tr -d '[:space:]')" ]; then
  base=$(git merge-base HEAD origin/main 2>/dev/null || echo "")
  [ -n "$base" ] && CHANGED=$(git diff --name-only "$base" HEAD 2>/dev/null)
fi

[ -z "$(printf '%s' "$CHANGED" | tr -d '[:space:]')" ] && exit 0

SCRAPER_CHANGED=$(printf '%s\n' "$CHANGED" | grep -E '^(src/scrapers/|config/data_filters\.json|src/lib/(practical_filters|relevance_guard))' || true)
DATA_CHANGED=$(printf '%s\n' "$CHANGED" | grep -E '^scraper_result\.json$' || true)

[ -z "$SCRAPER_CHANGED" ] && exit 0

say "スクレイパー/フィルタの変更を検出しました:"
printf '%s\n' "$SCRAPER_CHANGED" | sed 's/^/    /' >&2

# 1. データに依存しない検証。ここは常に実行する
say "型チェック・lint・フィルタ単体テストを実行します..."
npx tsc --noEmit -p tsconfig.json >&2
npm run --silent lint >&2
npm run --silent validate:filters >&2

if [ -n "$DATA_CHANGED" ]; then
  # 2. データを再生成した push。CIと同じ検証が意味を持つ
  say "scraper_result.json も更新されているため、CIと同じ検証を実行します..."
  npm run --silent validate:quality >&2
  npm run --silent validate:snapshots >&2
  say "${GREEN}すべての検証に通りました${RESET}"
  exit 0
fi

# 3. スクレイパーを変えたがデータは再生成していない
printf "\n" >&2
say "${YELLOW}スクレイパーを変更していますが、scraper_result.json が再生成されていません。${RESET}"
say "${YELLOW}この状態で validate:quality を回しても古いデータを見るだけで必ず通るため、${RESET}"
say "${YELLOW}スクレイパーの出力バグ(例: 落札なのに開札日がない)は検出できません。${RESET}"
printf "\n" >&2
say "次を実行して、実際にスクレイプした結果で検証してください:"
say "    ${BOLD}npm run verify:scrapers${RESET}"
say "（対象自治体は変更ファイルから自動判定されます。個別指定も可能です）"
say "    ${BOLD}npm run verify:scrapers -- 山添村,大淀町${RESET}"
printf "\n" >&2
say "検証済みで push したい場合: ${BOLD}git push --no-verify${RESET}"
exit 1
